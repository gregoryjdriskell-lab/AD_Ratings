# Required — create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional
# GEMINI_MODEL=gemini-2.5-pro        # or gemini-2.5-flash (faster, cheaper)
# GEMINI_VIDEO_FPS=2                 # frames/sec Gemini samples (0 = Gemini default of 1fps)
# PORT=8787
# MAX_CONCURRENT_AUDITS=3
# GEMINI_FILE_TIMEOUT_MS=180000
# CORS_ORIGIN=                       # only if the client is served from a different origin
